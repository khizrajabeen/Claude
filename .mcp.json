{
  "mcpServers": {
    "alpaca": {
      "command": "uvx",
      "args": ["alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY_ID}",
        "ALPACA_SECRET_KEY": "${ALPACA_API_SECRET_KEY}",
        "ALPACA_PAPER_TRADE": "true",
        "ALPACA_TOOLSETS": "account,stock-data,crypto-data,news,assets"
      }
    }
  }
}
