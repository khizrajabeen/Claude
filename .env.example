# Copy to .env and fill in. .env is gitignored — never commit it.
# The settings page's "Export .env" button writes this format.

# ── Exchange (crypto) ──
EXCHANGE_NAME=okx
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# ── Alpaca (US stocks and ETFs) ──
# Paper keys begin with PK, live keys with AK. Leave ALPACA_PAPER true
# until the record convinces you otherwise.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# ── Optional data sources ──
CRYPTOPANIC_TOKEN=
NEWSAPI_KEY=
COINMARKETCAP_KEY=

# ── Assistants (dashboard explanations only; not in the risk path) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Publishing ──
# Set to the branch GitHub Pages builds from to push web/data after each
# cycle. Leave empty to trade without publishing.
MERIDIAN_PUBLISH_BRANCH=
MERIDIAN_MODE=day
